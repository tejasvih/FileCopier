{
  // Folder that receives the backup. Required before copying. Use an absolute path
  // and double every backslash, for example "D:\\iPhone Backup\\".
  "AfcDestinationPath": "",

  // Optional safety check: stop before copying if the phone lists fewer files than this.
  // 0 turns the check off.
  "MinimumExpectedFiles": 0,

  // Only for --wpd (Windows Portable Devices, the Explorer view): the phone folder to copy
  // and a separate backup folder.
  "SourcePath": "\\Internal Storage",
  "DestinationPath": ""
}
